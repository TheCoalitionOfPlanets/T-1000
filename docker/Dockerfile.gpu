# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim AS web-build
WORKDIR /build
COPY package.json package-lock.json ./
COPY apps/web/package.json ./apps/web/package.json
RUN --mount=type=cache,target=/root/.npm npm ci
COPY apps/web/ ./apps/web/
RUN npm run build

FROM ghcr.io/astral-sh/uv:0.9.5 AS uv

FROM python:3.11-slim-bookworm AS python-build
COPY --from=uv /uv /usr/local/bin/uv
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git g++ \
    && rm -rf /var/lib/apt/lists/*
ENV UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never \
    UV_HTTP_TIMEOUT=300 UV_HTTP_RETRIES=5 UV_CONCURRENT_DOWNLOADS=4
RUN uv venv /opt/venv
ENV VIRTUAL_ENV=/opt/venv PATH="/opt/venv/bin:$PATH"
WORKDIR /build
COPY requirements/ ./requirements/
# Exact local-version pins select CUDA wheels rather than the CPU wheel build.
# Their nvidia-* dependencies supply the CUDA runtime libraries in the image.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --torch-backend cu128 \
        'torch==2.8.0+cu128' 'torchaudio==2.8.0+cu128' \
        -r requirements/gpu-low-vram.txt
COPY apps/api/ ./apps/api/
RUN uv pip install --no-deps ./apps/api

FROM python:3.11-slim-bookworm AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates ffmpeg libsndfile1 libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 t1000 \
    && useradd --uid 10001 --gid 10001 --create-home t1000
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    T1000_ROOT=/app \
    HF_HOME=/app/.cache/huggingface \
    XDG_CACHE_HOME=/app/.cache \
    T1000_CONTAINER_DEVICE=cuda \
    T1000_DOWNLOAD_MODELS=1 \
    T1000_PRELOAD_MODELS=1 \
    T1000_TTS_PROFILE=auto \
    T1000_TTS_OPTIMIZE=auto \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    TORCHINDUCTOR_CACHE_DIR=/app/.cache/torchinductor \
    TRITON_CACHE_DIR=/app/.cache/triton \
    CUDA_CACHE_PATH=/app/.cache/cuda \
    STT_BACKEND=cpu
WORKDIR /app
COPY --from=python-build /opt/venv /opt/venv
COPY --chown=10001:10001 apps/api/ ./apps/api/
COPY --chown=10001:10001 scripts/ ./scripts/
COPY --chown=10001:10001 assets/ ./assets/
COPY --chown=10001:10001 requirements/ ./requirements/
COPY --from=web-build --chown=10001:10001 /build/apps/web/dist/ ./apps/web/dist/
RUN mkdir -p /app/data/models /app/data/output /app/.cache \
    && chown -R 10001:10001 /app/data /app/.cache
# torch.compile/Triton build small host launchers at runtime. Keep their host
# compiler in the GPU image even though Python packages were built separately.
RUN apt-get update \
    && apt-get install -y --no-install-recommends g++ \
    && rm -rf /var/lib/apt/lists/*
USER 10001:10001
EXPOSE 7860
HEALTHCHECK --interval=30s --timeout=10s --start-period=30m --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:7860/api/health', timeout=5).read()"]
CMD ["python", "-m", "t1000.container"]
