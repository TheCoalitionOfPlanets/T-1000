# Keep the build context limited to the source inputs used by the images.
**
!package.json
!package-lock.json
!requirements/
!requirements/**
!apps/
!apps/api/
!apps/api/**
!apps/web/
!apps/web/**
!scripts/
!scripts/**
!assets/
!assets/**
!docker/
!docker/**

# Exclude generated files and local/private material within those trees too.
**/.git
**/.venv
**/venv
**/node_modules
**/data
**/.cache
**/dist
**/build
**/__pycache__
**/.pytest_cache
**/coverage
**/playwright-report
**/test-results
**/*.egg-info
**/*.pyc
**/*.pyo
**/*.tsbuildinfo
**/.env
**/.env.*
**/private.env
**/*.pem
**/*.key
